{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memoryd.local/schema/memory-protocol-v1.schema.json",
  "title": "memoryd protocol v1.0",
  "description": "Canonical request and response types shared by MCP, HTTP and CLI adapters.",
  "$defs": {
    "ScopeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userId"],
      "properties": {
        "userId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "branch": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "AgentProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "version", "capabilities"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "toolsetDigest": { "type": "string" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hooks", "stageGates"],
          "properties": {
            "hooks": { "type": "boolean" },
            "stageGates": { "type": "boolean" },
            "maxContextTokens": { "type": "integer", "minimum": 1 },
            "modalities": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "InputEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["idempotencyKey", "kind", "content"],
      "properties": {
        "eventId": { "type": "string" },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["user_message", "assistant_message", "tool_call", "tool_result", "attachment", "checkpoint", "compaction"]
        },
        "content": { "type": "string" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri"],
            "properties": {
              "uri": { "type": "string", "minLength": 1 },
              "mediaType": { "type": "string" },
              "contentHash": { "type": "string" }
            }
          }
        },
        "metadata": { "type": "object" }
      }
    },
    "SourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "sessionId", "contentHash", "capturedAt"],
      "properties": {
        "eventId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string", "minLength": 1 },
        "contentHash": { "type": "string", "minLength": 1 },
        "capturedAt": { "type": "string", "format": "date-time" },
        "workspaceId": { "type": "string" },
        "startOffset": { "type": "integer", "minimum": 0 },
        "endOffset": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "SourceEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "revision", "deviceId", "scope", "agent", "kind", "content", "contentHash", "capturedAt", "occurredAt", "selectedEvidence", "redactions", "attachments", "metadata"],
      "properties": {
        "eventId": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 },
        "deviceId": { "type": "string" },
        "scope": {
          "allOf": [
            { "$ref": "#/$defs/ScopeRef" },
            { "required": ["sessionId"] }
          ]
        },
        "agent": { "$ref": "#/$defs/AgentProfile" },
        "kind": { "$ref": "#/$defs/InputEvent/properties/kind" },
        "content": { "type": "string" },
        "contentHash": { "type": "string" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "selectedEvidence": { "type": "boolean" },
        "redactions": { "type": "array", "items": { "type": "string" } },
        "attachments": { "$ref": "#/$defs/InputEvent/properties/attachments" },
        "metadata": { "type": "object" }
      }
    },
    "RiskScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "probability", "contributions"],
      "properties": {
        "code": {
          "enum": ["entity_or_symbol_merge", "stale_source", "wrong_workspace", "cross_session_merge", "unsupported_inference", "narrative_completion", "destructive_action", "secret_exposure"]
        },
        "probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "contributions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "score", "reason"],
            "properties": {
              "source": { "enum": ["rule", "classifier", "calibration"] },
              "score": { "type": "number", "minimum": 0, "maximum": 1 },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "PolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "version", "scopeLevel", "authority", "text"],
      "properties": {
        "policyId": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "scopeLevel": { "enum": ["user", "workspace", "session"] },
        "authority": { "enum": ["user_explicit", "confirmed_learned"] },
        "text": { "type": "string" },
        "condition": true,
        "action": true,
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/SourceRef" } }
      }
    },
    "TurnPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "turnId", "snapshotRevision", "agentProfileKey", "risks", "modes", "retrievalStages", "gate", "activePolicies", "enforcementLevel", "retryCount", "createdAt"],
      "properties": {
        "protocolVersion": { "const": "1.0" },
        "turnId": { "type": "string" },
        "snapshotRevision": { "type": "integer", "minimum": 0 },
        "agentProfileKey": { "type": "string" },
        "risks": { "type": "array", "items": { "$ref": "#/$defs/RiskScore" } },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidenceFirst", "uncertainty", "retrieveOriginalSource", "askClarification", "narrativeCompletionGate"],
          "properties": {
            "evidenceFirst": { "$ref": "#/$defs/ModeLevel" },
            "uncertainty": { "$ref": "#/$defs/ModeLevel" },
            "retrieveOriginalSource": { "$ref": "#/$defs/ModeLevel" },
            "askClarification": { "$ref": "#/$defs/ModeLevel" },
            "narrativeCompletionGate": { "$ref": "#/$defs/ModeLevel" }
          }
        },
        "retrievalStages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "order", "blockedUntilCheckpoint"],
            "properties": {
              "name": { "$ref": "#/$defs/RetrievalStageName" },
              "order": { "type": "integer", "minimum": 0 },
              "blockedUntilCheckpoint": { "type": "boolean" }
            }
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "required", "satisfied"],
          "properties": {
            "kind": { "const": "evidence_checkpoint" },
            "required": { "type": "boolean" },
            "satisfied": { "type": "boolean" },
            "reason": { "type": "string" }
          }
        },
        "activePolicies": { "type": "array", "items": { "$ref": "#/$defs/PolicyRef" } },
        "enforcementLevel": { "enum": ["enforced", "advisory"] },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "ModeLevel": { "enum": ["off", "low", "medium", "high", "blocked"] },
    "RetrievalStageName": { "enum": ["policy", "current_evidence", "world", "episode", "source_expansion"] },
    "Observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "content"],
      "properties": {
        "observationId": { "type": "string" },
        "kind": { "enum": ["current_file", "image", "test", "command", "user_statement"] },
        "content": { "type": "string", "minLength": 1 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eventId": { "type": "string" },
            "sessionId": { "type": "string" },
            "contentHash": { "type": "string" },
            "capturedAt": { "type": "string", "format": "date-time" },
            "workspaceId": { "type": "string" },
            "startOffset": { "type": "integer", "minimum": 0 },
            "endOffset": { "type": "integer", "minimum": 0 },
            "path": { "type": "string" },
            "commit": { "type": "string" }
          }
        },
        "metadata": { "type": "object" }
      }
    },
    "WorldClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claimId", "subject", "predicate", "value", "scope", "confidence", "authority", "status", "sources", "version"],
      "properties": {
        "claimId": { "type": "string" },
        "subject": { "type": "string" },
        "predicate": { "type": "string" },
        "value": true,
        "scope": { "$ref": "#/$defs/ScopeRef" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "authority": { "enum": ["user_explicit", "confirmed_learned", "inferred"] },
        "status": { "enum": ["active", "superseded", "disputed", "revoked"] },
        "validFrom": { "type": "string", "format": "date-time" },
        "validTo": { "type": "string", "format": "date-time" },
        "supersedes": { "type": "string" },
        "conflictGroup": { "type": "string" },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/SourceRef" } },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "EpisodeMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episodeId", "scope", "title", "eventRefs", "participants", "tags", "startedAt", "endedAt"],
      "properties": {
        "episodeId": { "type": "string" },
        "scope": { "$ref": "#/$defs/ScopeRef" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "eventRefs": { "type": "array", "items": { "$ref": "#/$defs/SourceRef" } },
        "participants": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "startedAt": { "type": "string", "format": "date-time" },
        "endedAt": { "type": "string", "format": "date-time" }
      }
    },
    "MemoryBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "turnId", "snapshotRevision", "indexRevision", "stage", "worldClaims", "episodes", "sourceRefs", "policies", "counterexamples", "conflicts", "sourceCoverage", "trace", "untrustedEvidenceNotice"],
      "properties": {
        "protocolVersion": { "const": "1.0" },
        "turnId": { "type": "string" },
        "snapshotRevision": { "type": "integer", "minimum": 0 },
        "indexRevision": { "type": "integer", "minimum": 0 },
        "stage": { "$ref": "#/$defs/RetrievalStageName" },
        "worldClaims": { "type": "array", "items": { "$ref": "#/$defs/WorldClaim" } },
        "episodes": { "type": "array", "items": { "$ref": "#/$defs/EpisodeMemory" } },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/SourceRef" } },
        "policies": { "type": "array", "items": { "$ref": "#/$defs/PolicyRef" } },
        "counterexamples": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["correctionId", "wrongStatement", "correction", "source"],
            "properties": {
              "correctionId": { "type": "string" },
              "wrongStatement": { "type": "string" },
              "correction": { "type": "string" },
              "lesson": { "type": "string" },
              "source": { "$ref": "#/$defs/SourceRef" }
            }
          }
        },
        "conflicts": { "type": "array", "items": { "$ref": "#/$defs/WorldClaim" } },
        "sourceCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["query", "strategies", "candidateCount", "returnedCount"],
          "properties": {
            "query": { "type": "string" },
            "strategies": { "type": "array", "items": { "type": "string" } },
            "candidateCount": { "type": "integer", "minimum": 0 },
            "returnedCount": { "type": "integer", "minimum": 0 },
            "nextCursor": { "type": "string" }
          }
        },
        "untrustedEvidenceNotice": { "type": "string" }
      }
    },
    "VerifierResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceCoverage", "policyViolations", "unsupportedClaims", "conflicts"],
      "properties": {
        "status": { "enum": ["pass", "retry", "clarify", "abstain"] },
        "sourceCoverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "policyViolations": { "type": "array", "items": { "type": "string" } },
        "unsupportedClaims": { "type": "array", "items": { "type": "string" } },
        "conflicts": { "type": "array", "items": { "type": "string" } },
        "message": { "type": "string" }
      }
    },
    "BeginTurnRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "scope", "agentProfile"],
      "properties": {
        "input": { "$ref": "#/$defs/InputEvent" },
        "scope": {
          "allOf": [
            { "$ref": "#/$defs/ScopeRef" },
            { "required": ["sessionId"] }
          ]
        },
        "agentProfile": { "$ref": "#/$defs/AgentProfile" }
      }
    },
    "CheckpointEvidenceRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnId", "observations"],
      "properties": {
        "turnId": { "type": "string" },
        "observations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/Observation" } }
      }
    },
    "CheckpointEvidenceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "observations", "evidenceRefs"],
      "properties": {
        "plan": { "$ref": "#/$defs/TurnPlan" },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["observationId", "kind", "source"],
            "properties": {
              "observationId": { "type": "string" },
              "kind": { "$ref": "#/$defs/Observation/properties/kind" },
              "source": { "$ref": "#/$defs/SourceRef" }
            }
          }
        },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/SourceRef" } }
      }
    },
    "RecallRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnId", "stage", "query"],
      "properties": {
        "turnId": { "type": "string" },
        "stage": { "$ref": "#/$defs/RetrievalStageName" },
        "query": { "type": "string" },
        "budgetTokens": { "type": "integer", "minimum": 1, "maximum": 8000 },
        "cursor": { "type": "string" }
      }
    },
    "GetSourcesRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnId", "sourceRefs"],
      "properties": {
        "turnId": { "type": "string" },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/SourceRef" }
        }
      }
    },
    "CorrectionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnId", "kind", "correction", "explicit", "idempotencyKey"],
      "properties": {
        "turnId": { "type": "string" },
        "kind": { "enum": ["fact", "behavior", "unknown"] },
        "wrongStatement": { "type": "string" },
        "correction": { "type": "string", "minLength": 1 },
        "subject": { "type": "string" },
        "predicate": { "type": "string" },
        "value": true,
        "scopeLevel": { "enum": ["user", "workspace", "session"] },
        "explicit": { "type": "boolean" },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      }
    },
    "CompleteTurnRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnId", "response", "idempotencyKey", "evidenceRefs"],
      "properties": {
        "turnId": { "type": "string" },
        "response": { "type": "string" },
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/SourceRef" } },
        "verifierResult": { "$ref": "#/$defs/VerifierResult" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/BeginTurnRequest" },
    { "$ref": "#/$defs/CheckpointEvidenceRequest" },
    { "$ref": "#/$defs/CheckpointEvidenceResult" },
    { "$ref": "#/$defs/RecallRequest" },
    { "$ref": "#/$defs/GetSourcesRequest" },
    { "$ref": "#/$defs/CorrectionRequest" },
    { "$ref": "#/$defs/CompleteTurnRequest" },
    { "$ref": "#/$defs/TurnPlan" },
    { "$ref": "#/$defs/MemoryBundle" },
    { "$ref": "#/$defs/SourceEvent" }
  ]
}
